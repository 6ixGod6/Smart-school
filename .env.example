# Smart School — environment template.
# Copy to .env and fill in locally. NEVER commit a real .env (§2.4).
# In production these live in Railway's environment variable settings.
#
# Only the variables used by the current build step are listed. Later steps
# (MoMo collection/disbursement, VAPID web push, SMS for PIN reset) add their
# own entries here when they are actually built.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Database (PostgreSQL — Railway in production)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Used by `pnpm test`. A separate database so tests can truncate freely.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST:5432/DATABASE_TEST?schema=public

# ---------------------------------------------------------------------------
# Auth (§5)
# ---------------------------------------------------------------------------
# Signing secret for JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Rotating this invalidates every access token.
JWT_ACCESS_SECRET=

# Separate secret used to hash refresh tokens at rest, so a database dump alone
# is not enough to mint a session. Generate the same way as above.
REFRESH_TOKEN_PEPPER=

# Access token lifetime. Kept short (§1: ~15 min) because it is not revocable.
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token lifetime. Parents stay signed in for weeks (§5.7); staff sessions
# are deliberately shorter because the admin surface is higher risk (§5).
PARENT_REFRESH_TOKEN_TTL_DAYS=60
STAFF_REFRESH_TOKEN_TTL_DAYS=7

# bcrypt work factor for staff passwords and parent PINs.
BCRYPT_ROUNDS=12

# PIN/password brute-force lockout (§5.6).
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Parent PIN guesses keyed on phone + client IP (not the account row). Higher
# than the per-account cap so a typo that locks School A does not also lock
# this IP out of School B; low enough that omitting schoolId is not free.
PARENT_PHONE_IP_MAX_FAILED_ATTEMPTS=20
PARENT_PHONE_IP_LOCKOUT_MINUTES=15

# IP rate limits. Auth is tighter so one address cannot lock many parent
# accounts (5 failures lock an account). 40 / 15 min is enough for a PTA
# wifi login burst and caps one IP at locking ~8 parent accounts per window.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=40
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
